# .htaccess for mylocalsmallbusiness.uk (static marketing site)

# No directory listings
Options -Indexes

# ---------------------------------------------------------------
# Canonical host + HTTPS
# ---------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www -> apex
  RewriteCond %{HTTP_HOST} ^www\.mylocalsmallbusiness\.uk$ [NC]
  RewriteRule ^(.*)$ https://mylocalsmallbusiness.uk/$1 [R=301,L]

  # http -> https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^mylocalsmallbusiness\.uk$ [NC]
  RewriteRule ^(.*)$ https://mylocalsmallbusiness.uk/$1 [R=301,L]
</IfModule>

# ---------------------------------------------------------------
# Block private files (server config and internal documents)
# ---------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteRule ^config(/|$) - [F,L]
  RewriteRule ^assets/documents(/|$) - [F,L]
</IfModule>

# Never serve PHP source or backup files from this static site
<FilesMatch "\.(php|phps|ini|log|sh|bak)$">
  Require all denied
</FilesMatch>

# ---------------------------------------------------------------
# Compression + caching
# ---------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png  "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css  "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# ---------------------------------------------------------------
# Sensible security headers (crawler-friendly; no noindex here)
# ---------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
